{
    "mcpServers": {
        "mcp-vector-search": {
            "type": "stdio",
            "command": "trusty-search",
            "args": [
                "serve"
            ],
            "env": {
                "TRUSTY_INDEX": "kuzu-memory"
            }
        },
        "trusty-search": {
            "type": "stdio",
            "command": "trusty-search",
            "args": [
                "serve"
            ]
        },
        "trusty-memory": {
            "type": "stdio",
            "command": "trusty-memory",
            "args": [
                "serve",
                "--palace",
                "kuzu-memory"
            ]
        }
    }
}